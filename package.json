{
  "name": "opencode-usage-bars",
  "version": "0.1.2",
  "description": "Usage bars for the OpenCode V2 TUI sidebar",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdiY00/opencode-usage-bars.git"
  },
  "homepage": "https://github.com/AdiY00/opencode-usage-bars#readme",
  "bugs": "https://github.com/AdiY00/opencode-usage-bars/issues",
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts",
    "./tui": "./src/tui.tsx"
  },
  "scripts": {
    "build": "bun build src/index.ts src/tui.tsx --outdir dist --target bun --external '@opencode-ai/*' --external '@opentui/*' --external solid-js && bunx tsc -p tsconfig.build.json",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun run typecheck && bun run build",
    "prepack": "bun run check"
  },
  "dependencies": {
    "@opencode-ai/plugin": "beta"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.9",
    "@opentui/solid": ">=0.5.9",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.9",
    "@opentui/solid": "^0.5.9",
    "@types/bun": "latest",
    "solid-js": "1.9.12",
    "typescript": "5.8.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
