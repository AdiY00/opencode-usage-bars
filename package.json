{
  "name": "opencode-usage-bars",
  "version": "0.1.4",
  "description": "Usage bars for the OpenCode V2 terminal and desktop",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdiY00/opencode-usage-bars.git"
  },
  "homepage": "https://github.com/AdiY00/opencode-usage-bars#readme",
  "bugs": "https://github.com/AdiY00/opencode-usage-bars/issues",
  "files": [
    "src",
    "dist/gui-experimental.cjs"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "scripts": {
    "build": "bun build src/index.ts src/tui.tsx --outdir dist --target bun --external '@opencode/*' --external '@opentui/*' --external solid-js && vite build && bunx tsc -p tsconfig.build.json",
    "dev:gui": "vite build --watch",
    "sync:desktop": "bun scripts/sync-desktop.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun run build",
    "prepack": "bun run check"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.0",
    "effect": "4.0.1",
    "zod": "^4.1.8"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.10",
    "@opentui/solid": "^0.5.10",
    "@types/bun": "latest",
    "solid-js": "1.9.12",
    "typescript": "5.8.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
