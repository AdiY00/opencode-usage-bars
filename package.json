{
  "name": "opencode-usage-bars",
  "version": "0.0.0",
  "description": "Pace-aware Codex and OpenCode Go usage bars for the OpenCode TUI",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts src/tui.tsx --outdir dist --target bun --external '@opencode-ai/*' --external '@opentui/*' --external solid-js && bunx tsc -p tsconfig.build.json",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun run typecheck && bun run build",
    "prepare": "bun run check"
  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-next-17403"
  },
  "peerDependencies": {
    "@opentui/core": "0.0.0-20260808-9ecf7c0a",
    "@opentui/solid": "0.0.0-20260808-9ecf7c0a",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opentui/core": "0.0.0-20260808-9ecf7c0a",
    "@opentui/solid": "0.0.0-20260808-9ecf7c0a",
    "@types/bun": "latest",
    "solid-js": "1.9.12",
    "typescript": "5.8.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
